--cpu=Cortex-M4.fp.sp
"switchnuc\startup_stm32f401xe.o"
"switchnuc\main.o"
"switchnuc\stm32f4xx_it.o"
"switchnuc\stm32f4xx_hal_msp.o"
"switchnuc\stm32f4xx_hal_rcc.o"
"switchnuc\stm32f4xx_hal_rcc_ex.o"
"switchnuc\stm32f4xx_hal_flash.o"
"switchnuc\stm32f4xx_hal_flash_ex.o"
"switchnuc\stm32f4xx_hal_flash_ramfunc.o"
"switchnuc\stm32f4xx_hal_gpio.o"
"switchnuc\stm32f4xx_hal_dma_ex.o"
"switchnuc\stm32f4xx_hal_dma.o"
"switchnuc\stm32f4xx_hal_pwr.o"
